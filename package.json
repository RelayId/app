{
    "name": "relayid-app",
    "private": true,
    "packageManager": "pnpm@10.33.0",
    "main": "src/main.ts",
    "scripts": {
        "start": "expo start",
        "android": "expo run:android --variant release",
        "android:release:fast": "powershell -ExecutionPolicy Bypass -File scripts/build-android-fast.ps1 -Install",
        "android:dev": "expo run:android",
        "ios": "expo run:ios",
        "prebuild": "expo prebuild",
        "test": "jest --runInBand",
        "typecheck": "tsc --noEmit",
        "doctor": "pnpm dlx expo-doctor@latest",
        "verify": "pnpm typecheck && pnpm test"
    },
    "pnpm": {
        "overrides": {
            "uuid@<11.1.1": ">=11.1.1",
            "write-file-atomic": "8.0.0"
        }
    },
    "dependencies": {
        "@sbaiahmed1/react-native-biometrics": "^0.16.1",
        "asn1js": "^3.0.10",
        "expo": "~57.0.27",
        "expo-application": "~7.0.2",
        "expo-camera": "~57.0.6",
        "expo-device": "~57.0.2",
        "expo-linking": "~57.0.12",
        "expo-secure-store": "~57.0.4",
        "expo-web-browser": "~57.0.3",
        "lucide-react-native": "^1.52.0",
        "react": "19.2.3",
        "react-native": "0.86.3",
        "react-native-nitro-modules": "^0.37.1",
        "react-native-quick-base64": "^3.0.1",
        "react-native-quick-crypto": "^1.1.8",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-svg": "15.15.4",
        "relayid-wear": "workspace:*"
    },
    "devDependencies": {
        "@types/jest": "29.5.14",
        "@types/react": "~19.2.4",
        "babel-preset-expo": "57.0.14",
        "jest": "~29.7.0",
        "jest-expo": "~57.0.5",
        "typescript": "~6.0.3"
    }
}
